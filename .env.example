# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# DeepSeek API (主力推理：多空辩论、逻辑分析)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DAILY_LIMIT=50

# OpenAI / GPT API (用于A股产业链联想、关键词提取、多模型交叉会诊)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_DAILY_LIMIT=50

# Gemini API (用于生成说人话的最终报告与持仓会诊)
GEMINI_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-1.5-flash

# Kimi API (中文长文本与高可用替补API)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_DAILY_LIMIT=30

# Qwen API (可选兼容，未配置时自动由 GPT / Gemini / DeepSeek / Kimi 接管)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# SerpApi (用于海外新闻信息差检测，可选)
SERPAPI_KEY=your_serpapi_key_here

# 数据源与回测配置 (v2.0)
ENABLE_DOMESTIC_7X24=1
BACKTEST_SLIPPAGE=0.0015

# Streamlit Dashboard
DASHBOARD_PASSWORD=123456

# Redis 配置
REDIS_HOST=127.0.0.1

# 服务器标签
SERVER_LABEL=Oracle Cloud ARM64

# ================= 1. 消息推送通道配置 (v2.1) =================
# 方式 A (推荐): Bark iOS 苹果手机原生推送 (也可直接在 Web 控制台『推送与系统设置』页面填写)
BARK_URL=https://api.day.app/your_bark_key_here
BARK_GROUP=A股量化哨兵
BARK_LEVEL=timeSensitive
BARK_SOUND=glass
DASHBOARD_URL=http://your_server_ip

# 方式 B (可选): Discord / 飞书 / 企业微信 / 钉钉 / Slack / 自定义 JSON Webhook
WEBHOOK_URL=

# 方式 C (旧版兼容，如已停用 Telegram 可留空或设置 DISABLE_TELEGRAM=1)
DISABLE_TELEGRAM=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================= 2. AI 多模型配置 =================
# DeepSeek API (主力推理：多空辩论、逻辑分析)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DAILY_LIMIT=50

# OpenAI / GPT API (用于A股产业链联想、关键词提取、多模型交叉会诊)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_DAILY_LIMIT=50

# Gemini API (用于生成说人话的最终报告与持仓会诊)
GEMINI_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-1.5-flash

# Kimi API (中文长文本与高可用替补API)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_DAILY_LIMIT=30

# Qwen API (可选兼容，未配置时自动由 GPT / Gemini / DeepSeek / Kimi 接管)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ================= 3. 数据源与系统配置 =================
# SerpApi (用于海外新闻信息差检测，可选)
SERPAPI_KEY=your_serpapi_key_here

# 数据源与回测配置 (v2.0)
ENABLE_DOMESTIC_7X24=1
BACKTEST_SLIPPAGE=0.0015

# Streamlit Dashboard 访问密码
DASHBOARD_PASSWORD=change_me_to_a_strong_password

# Redis 配置
REDIS_HOST=127.0.0.1

# 服务器标签
SERVER_LABEL=Oracle Cloud ARM64
